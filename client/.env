# Authentication mode: 'mock' | 'token_url' | 'cookie'
# - mock: fixed test user for development (default)
# - token_url: read token from URL query param (?token=...) on redirect entry
# - cookie: shared session cookie, fetch user from ME_ENDPOINT
VITE_AUTH_MODE=mock

# URL of the main app (team's app) that handles login/signup
# Used for redirect when no user is found
VITE_MAIN_APP_URL=http://localhost:3000

# Endpoint to fetch current user when using cookie mode
# e.g., https://api.mainapp.example/api/me
VITE_ME_ENDPOINT=/api/me